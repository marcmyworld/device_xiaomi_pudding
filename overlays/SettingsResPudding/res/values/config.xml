<resources>
    <!-- The Xiaomi face HAL opens the front camera itself and renders the enrollment preview
         into the surface Settings passes; Settings must not open the camera too -->
    <bool name="config_face_enroll_hal_owns_camera">true</bool>

    <!-- Names of the Xiaomi colour modes of config_availableColorModes -->
    <string-array name="config_color_mode_options_strings" translatable="false">
        <item>Vivid</item>
        <item>Saturated</item>
        <item>Standard</item>
        <item>Original</item>
        <item>P3</item>
        <item>sRGB</item>
    </string-array>
    <integer-array name="config_color_mode_options_values" translatable="false">
        <item>258</item>
        <item>256</item>
        <item>257</item>
        <item>269</item>
        <item>268</item>
        <item>267</item>
    </integer-array>

    <!-- The Qualcomm RIL rejects network scans longer than 254 s (INVALID_ARGUMENTS); the
         Settings default of 300 s breaks manual network selection -->
    <integer name="config_network_scan_helper_max_search_time_sec">254</integer>
</resources>
