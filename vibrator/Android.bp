cc_binary {
    name: "vibratorfeature-wrapper",
    relative_install_path: "hw",
    device_specific: true,
    init_rc: ["vibratorfeature-wrapper.rc"],
    vintf_fragments: ["vibratorfeature-wrapper.xml"],
    srcs: [
        "Vibrator.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.vibrator-V2-ndk",
        "libbase",
        "libbinder_ndk",
    ],
    static_libs: [
        "vendor.xiaomi.hardware.vibratortuner-V1-ndk",
    ],
}
