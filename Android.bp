soong_namespace {
    imports: ["vendor/xiaomi/pudding"],
}

// EuiccGoogle (eSIM LPA)
android_app_import {
    name: "EuiccGoogle",
    apk: ":EuiccGoogle_apk",
    presigned: true,
    preprocessed: true,
    privileged: true,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

// Fingerprint
prebuilt_etc {
    name: "init.fingerprint.pudding.rc",
    src: "configs/init/init.fingerprint.pudding.rc",
    sub_dir: "init",
    device_specific: true,
}

vintf_fragment {
    name: "vendor.qti.hardware.fingerprint.pudding.xml",
    src: "configs/vintf/vendor.qti.hardware.fingerprint.pudding.xml",
    device_specific: true,
}

// Touch
prebuilt_usr_keylayout {
    name: "NVTCapacitiveTouchScreen.kl",
    src: "configs/keylayout/NVTCapacitiveTouchScreen.kl",
    device_specific: true,
}

prebuilt_usr_keylayout {
    name: "Xiaomi_Touch_Input_0.kl",
    src: "configs/keylayout/Xiaomi_Touch_Input_0.kl",
    device_specific: true,
}
